[{"nodes": [{"id": 1, "description": "SERVICE_WIN32", "type": "TTPS"}, {"id": 2, "description": "Brower service", "type": "APPS"}, {"id": 3, "description": "svchost.exe -k netsvcs", "type": "EXEF"}, {"id": 4, "description": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\\\Parameters", "type": "REGI"}, {"id": 5, "description": "%USERPROFILE%\\.dll", "type": "DOCF"}, {"id": 6, "description": "kernel32.dll", "type": "EXEF"}, {"id": 7, "description": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\\\Parameters\\ServiceDll = \"%USERPROFILE%\\.dll\"", "type": "REGI"}, {"id": 8, "description": "%SystemRoot%\\System32\\svchost.exe -k \"random name\"", "type": "EXEF"}, {"id": 9, "description": "<random name>.dll", "type": "DOCF"}, {"id": 10, "description": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\SvcHost\\ = <random name>", "type": "REGI"}, {"id": 11, "description": "rundll32.exe \"%USERPROFILE%\\.dll\", Launch", "type": "EXEF"}, {"id": 12, "description": "%system%\\cmd.exe /c del \"\" > nul", "type": "EXEF"}], "edges": [{"source": 1, "target": 2, "rel_name": "checks for service with type"}, {"source": 3, "target": 4, "rel_name": "retrieves from registry key"}, {"source": 5, "target": 6, "rel_name": "modifies file time attributes to match"}, {"source": 7, "target": 5, "rel_name": "sets as service dll path"}, {"source": 8, "target": 9, "rel_name": "creates with random name and binary path"}, {"source": 10, "target": 9, "rel_name": "adds to registry for execution on start"}, {"source": 11, "target": 5, "rel_name": "executes to launch dll component"}, {"source": 12, "target": 5, "rel_name": "deletes the dropper component"}]}]